# Copy to .env (never commit it). The code reads the process environment only;
# with uv you can load the file via: uv run --env-file .env python -m app chat
CARWISE_PROFILE=dev
OPENAI_API_KEY=
# Optional: any OpenAI-compatible server, for example Ollama (http://localhost:11434/v1).
OPENAI_BASE_URL=
