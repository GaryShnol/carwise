# Copy to .env (never commit it). The code reads the process environment only;
# with uv you can load the file via: uv run --env-file .env python -m app chat
CARWISE_PROFILE=dev
OPENAI_API_KEY=
# Optional: any OpenAI-compatible server instead of OpenAI. Leave it commented out
# for OpenAI; an empty value is treated as unset.
# OPENAI_BASE_URL=http://localhost:11434/v1
